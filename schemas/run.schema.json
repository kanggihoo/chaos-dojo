{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chaos-lab.local/schemas/run.schema.json",
  "title": "chaos-lab run result",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "problem",
    "scenario",
    "impl",
    "exit_code",
    "repeats",
    "identity",
    "aggregate",
    "live_status",
    "cleanup"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9]{8}-[0-9]{6}-[a-z0-9-]+-[a-z0-9]{6}$"
    },
    "problem": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "maxLength": 40
    },
    "scenario": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "maxLength": 40
    },
    "impl": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "maxLength": 40
    },
    "exit_code": {
      "enum": [
        0,
        1,
        3
      ]
    },
    "repeats": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "n",
          "completion",
          "validity"
        ],
        "properties": {
          "n": {
            "type": "integer",
            "minimum": 1
          },
          "completion": {
            "enum": [
              "pass",
              "fail",
              "unknown",
              "met",
              "missed",
              "complete",
              "incomplete",
              "valid",
              "invalid",
              "not-run"
            ]
          },
          "validity": {
            "enum": [
              "pass",
              "fail",
              "unknown",
              "met",
              "missed",
              "complete",
              "incomplete",
              "valid",
              "invalid",
              "not-run"
            ]
          }
        }
      }
    },
    "identity": {
      "type": "object",
      "required": [
        "harness"
      ],
      "properties": {
        "harness": {
          "type": "object",
          "required": [
            "commit",
            "dirty"
          ],
          "properties": {
            "commit": {
              "type": [
                "string",
                "null"
              ]
            },
            "dirty": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "aggregate": {
      "type": "object"
    },
    "live_status": {
      "enum": [
        "ok",
        "degraded"
      ]
    },
    "cleanup": {
      "type": "object"
    }
  }
}
